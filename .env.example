# ---------------------------------------------------------------------------
# Spark AI Lead Qualification Agent - configuration
#
# Copy to .env and fill in what you have. EVERY external service below is
# optional: with an empty .env the whole pipeline still runs end to end using
# the deterministic classifier, the local mock CRM and console notifications.
# Add credentials one at a time to light up each real integration.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_PATH=data/leads.db

# Shared secret required on the service-to-service endpoints (/classify,
# /crm/upsert, /notify, /leads/record). Leave EMPTY for local development to
# disable the check. SET THIS before exposing the service anywhere.
# The same value must be given to n8n so its HTTP nodes can send it.
API_KEY=

# Comma-separated origins for the browser form. Narrow this in production.
CORS_ALLOW_ORIGINS=*

# Rate limit on the public intake endpoint (per client IP).
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM -------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run on the deterministic rules engine.
# That is a supported mode, not a broken one: it is how CI runs and how the
# project demos without spending anything.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
AGENT_MAX_TOOL_ROUNDS=3

# --- CRM -------------------------------------------------------------------
# mock        - local SQLite store. No account needed. The default.
# gohighlevel - real GoHighLevel v2 API. Requires a paid GHL account.
# hubspot     - real HubSpot CRM v3 API. Free developer tier works.
CRM_PROVIDER=mock

# GoHighLevel (only read when CRM_PROVIDER=gohighlevel)
#   1. Settings -> Private Integrations -> create a token with contacts.write
#      and opportunities.write
#   2. Location ID is in the dashboard URL: /v2/location/<THIS>/
#   3. Pipeline and stage IDs: GET /opportunities/pipelines
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28
GHL_PIPELINE_ID=
GHL_STAGE_HIGH=
GHL_STAGE_MEDIUM=
GHL_STAGE_LOW=

# HubSpot (only read when CRM_PROVIDER=hubspot)
#   Create a private app with crm.objects.contacts.read/write and paste the
#   pat-... token. Run `python scripts/hubspot_setup.py` once to create the
#   custom AI properties.
HUBSPOT_TOKEN=

CRM_TIMEOUT_SECONDS=20
CRM_MAX_RETRIES=2

# --- notification ----------------------------------------------------------
# Slack Incoming Webhook (free): https://api.slack.com/messaging/webhooks
# Leave empty and high-priority alerts are printed to the service log and
# stored at GET /api/v1/notifications instead.
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=10

# Which priorities page the sales team. Comma separated.
NOTIFY_ON_PRIORITIES=High

# --- n8n -------------------------------------------------------------------
# Where the workflow's HTTP nodes should reach this service. Inside docker
# compose that is the service name; running n8n on the host use
# http://localhost:8000
API_BASE_URL=http://api:8000
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Dubai
